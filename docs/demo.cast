{"version": 2, "width": 96, "height": 46, "timestamp": 1792128295, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "minidbg: a small ptrace debugger"}
[0.0193, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.01993, "o", "\u001b[1;32m$\u001b[0m ./build/minidbg -x demo/factorial.cmds ./build/examples/factorial\r\n"]
[1.024173, "o", "Launched ./build/examples/factorial (pid 2000579).\r\n"]
[1.024303, "o", "Position-independent executable loaded at 0x555555554000.\r\nRead 9 function symbols.\r\nStopped before the program's first instruction:\r\n  rip = 0x7ffff7fe4540 <unknown>\r\nType 'continue' to run it, 'help' for commands.\r\n(minidbg) # minidbg demo 1/2: breakpoint, registers, stack memory, backtrace\r\n"]
[2.523296, "o", "(minidbg) #\r\n"]
[4.025452, "o", "(minidbg) # 1. Stop at the start of a function, by name\r\n"]
[5.528093, "o", "(minidbg) break factorial\r\nBreakpoint 1 at 0x555555555149 <factorial+0>\r\n"]
[6.630268, "o", "(minidbg) continue\r\n"]
[6.630731, "o", "Breakpoint 1 hit.\r\n  rip = 0x555555555149 <factorial+0>\r\n"]
[7.732741, "o", "(minidbg) # 2. rdi holds the first argument: n = 5. Look at all registers\r\n"]
[9.235296, "o", "(minidbg) regs\r\nrax       0x0000555555555183  93824992235907\r\nrbx       0x00007fffffffdc38  140737488346168\r\nrcx       0x0000555555557dc0  93824992247232\r\nrdx       0x00007fffffffdc48  140737488346184\r\nrsi       0x00007fffffffdc38  140737488346168\r\nrdi       0x0000000000000005  5\r\nrbp       0x00007fffffffdb10  140737488345872\r\nrsp       0x00007fffffffdaf8  140737488345848\r\nr8        0x0000000000000000  0\r\nr9        0x00007ffff7fca380  140737353917312\r\nr10       0x00007fffffffd830  140737488345136\r\nr11       0x0000000000000203  515\r\nr12       0x0000000000000001  1\r\nr13       0x0000000000000000  0\r\nr14       0x0000555555557dc0  93824992247232\r\nr15       0x00007ffff7ffd000  140737354125312\r\nrip       0x0000555555555149  93824992235849\r\neflags    0x0000000000000206  518\r\ncs        0x0000000000000033  51\r\nss        0x000000000000002b  43\r\nds        0x0000000000000000  0\r\nes        0x0000000000000000  0\r\n"]
[9.235442, "o", "fs        0x0000000000000000  0\r\ngs        0x0000000000000000  0\r\nfs_base   0x00007ffff7fa0740  140737353746240\r\ngs_base   0x0000000000000000  0\r\norig_rax  0xffffffffffffffff  -1\r\n"]
[12.23723, "o", "(minidbg) # 3. Change the argument! Pretend main had called factorial(3)\r\n"]
[13.738762, "o", "(minidbg) set rdi 3\r\nrdi = 0x3\r\n"]
[14.841738, "o", "(minidbg) # 4. Single-step through the prologue (note the function+offset)\r\n"]
[16.343734, "o", "(minidbg) stepi\r\n  rip = 0x55555555514d <factorial+4>\r\n"]
[16.945686, "o", "(minidbg) stepi\r\n  rip = 0x55555555514e <factorial+5>\r\n"]
[17.547755, "o", "(minidbg) stepi\r\n  rip = 0x555555555151 <factorial+8>\r\n"]
[18.150063, "o", "(minidbg) stepi\r\n"]
[18.150288, "o", "  rip = 0x555555555152 <factorial+9>\r\n"]
[18.752883, "o", "(minidbg) stepi\r\n"]
[18.752964, "o", "  rip = 0x555555555156 <factorial+13>\r\n"]
[19.355347, "o", "(minidbg) stepi\r\n"]
[19.355479, "o", "  rip = 0x555555555159 <factorial+16>\r\n"]
[19.958057, "o", "(minidbg) # 5. n now lives on the stack. Read that stack variable: it holds our 3\r\n"]
[21.460543, "o", "(minidbg) x 0x7fffffffdadc 1\r\n0x7fffffffdadc:  0x0000000000000003\r\n"]
[22.56351, "o", "(minidbg) # 6. Run to the next recursive call and look at the call stack\r\n"]
[24.065822, "o", "(minidbg) continue\r\nBreakpoint 1 hit.\r\n  rip = 0x555555555149 <factorial+0>\r\n"]
[25.167535, "o", "(minidbg) bt\r\n#0  0x0000555555555149 <factorial+0>\r\n#1  0x0000555555555179 <factorial+48>\r\n#2  0x0000555555555199 <main+22>\r\n#3  0x00007ffff7c2a1ca <unknown>\r\n"]
[26.269347, "o", "(minidbg) # 7. Let the program finish: it prints 6 instead of 120\r\n"]
[27.771013, "o", "(minidbg) delete 1\r\nDeleted breakpoint 1.\r\n"]
[28.873582, "o", "(minidbg) continue\r\n"]
[28.87376, "o", "factorial(5) = 6\r\n"]
[28.873886, "o", "Process 2000579 exited with code 0.\r\n"]
[29.976229, "o", "(minidbg) quit\r\n"]
[31.980303, "o", "\u001b[H\u001b[2J\u001b[3J"]
[31.980518, "o", "\u001b[1;32m$\u001b[0m ./build/minidbg -x demo/segfault.cmds ./build/examples/segfault\r\n"]
[32.987124, "o", "Launched ./build/examples/segfault (pid 2001514).\r\n"]
[32.987366, "o", "Position-independent executable loaded at 0x555555554000.\r\nRead 9 function symbols.\r\nStopped before the program's first instruction:\r\n  rip = 0x7ffff7fe4540 <unknown>\r\nType 'continue' to run it, 'help' for commands.\r\n(minidbg) # minidbg demo 2/2: catching a crash\r\n"]
[34.487279, "o", "(minidbg) #\r\n"]
[35.989982, "o", "(minidbg) # 1. Just run it. The debugger stops at the crash instead of losing it\r\n"]
[37.491791, "o", "(minidbg) continue\r\n"]
[37.492195, "o", "about to crash\r\nProgram received signal SIGSEGV (Segmentation fault).\r\n  rip = 0x555555555159 <crash+16>\r\n"]
[38.593909, "o", "(minidbg) # 2. Where did it die? Walk the call stack\r\n"]
[40.096698, "o", "(minidbg) bt\r\n#0  0x0000555555555159 <crash+16>\r\n#1  0x0000555555555183 <main+33>\r\n#2  0x00007ffff7c2a1ca <unknown>\r\n"]
[41.198656, "o", "(minidbg) # 3. Let the signal through: the program dies the normal way\r\n"]
[42.701126, "o", "(minidbg) continue\r\n"]
[43.80703, "o", "Process 2001514 was killed by SIGSEGV (Segmentation fault).\r\n(minidbg) quit\r\n"]
